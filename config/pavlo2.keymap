#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    combos {
        compatible = "zmk,combos";

        Escape {
                    bindings = <&kp ESC>;
                    key-positions = <1 3>;
                };
    };

    keymap {
        compatible = "zmk,keymap";

        DEF {
            bindings = <
&kp ESC         &kp LEFT_SHIFT                          &kp W                                         &kp UP                &kp NUMBER_7    &kp NUMBER_8    &kp NUMBER_9
&kp LCTRL       &kp TAB         &kp LGUI   &kp A        &kp S         &kp D                &kp LEFT              &kp RIGHT  &kp NUMBER_4    &kp NUMBER_5    &kp NUMBER_6
                &kp LEFT_ALT                            &kp C                                         &kp DOWN              &kp NUMBER_1    &kp NUMBER_2    &kp NUMBER_3
&kp SPACE       &kp J                                   &kp LEFT_ALT  &kp E                &kp V      &kp L      &kp N      &kp N0          &kp DOT         &kp ENTER
            >;
        };
    };
};