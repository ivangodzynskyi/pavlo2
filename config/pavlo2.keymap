#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo_q {
            bindings = <&kp Q>;
            key-positions = <2 10 3 13>;
            timeout-ms = <100>;
        };

        combo_w {
            bindings = <&kp W>;
            key-positions = <10 2 3 15>;
            timeout-ms = <100>;
        };

        combo_r {
            bindings = <&kp R>;
            key-positions = <2 15>;
            timeout-ms = <100>;
        };

        combo_backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <10 13>;
            timeout-ms = <100>;
        };

        combo_y {
            bindings = <&kp Y>;
            key-positions = <20 3 13>;
            timeout-ms = <100>;
        };

        combo_u {
            bindings = <&kp U>;
            key-positions = <20 3>;
            timeout-ms = <100>;
        };

        combo_i {
            bindings = <&kp I>;
            key-positions = <2 21>;
            timeout-ms = <100>;
        };

        combo_o {
            bindings = <&kp O>;
            key-positions = <10 20 3 15>;
            timeout-ms = <100>;
        };

        combo_p {
            bindings = <&kp P>;
            key-positions = <20 15 3>;
            timeout-ms = <100>;
        };

        combo_s {
            bindings = <&kp S>;
            key-positions = <10 2 21 15>;
            timeout-ms = <100>;
        };

        combo_d {
            bindings = <&kp D>;
            key-positions = <10 2 13 21>;
            timeout-ms = <100>;
        };

        combo_f {
            bindings = <&kp F>;
            key-positions = <15 3 12>;
            timeout-ms = <100>;
        };

        combo_g {
            bindings = <&kp G>;
            key-positions = <21 15 12>;
            timeout-ms = <100>;
        };

        combo_h {
            bindings = <&kp H>;
            key-positions = <10 15>;
            timeout-ms = <100>;
        };

        combo_j {
            bindings = <&kp J>;
            key-positions = <2 13 21>;
            timeout-ms = <100>;
        };

        combo_k {
            bindings = <&kp K>;
            key-positions = <2 12 21 15>;
            timeout-ms = <100>;
        };

        combo_l {
            bindings = <&kp L>;
            key-positions = <2 15 21>;
            timeout-ms = <100>;
        };

        combo_semicolon {
            bindings = <&kp SEMICOLON>;
            key-positions = <20 3>;
            timeout-ms = <100>;
        };

        combo_apost {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <2 13>;
            timeout-ms = <100>;
        };

        combo_z {
            bindings = <&kp Z>;
            key-positions = <2 12 13 21>;
            timeout-ms = <100>;
        };

        combo_x {
            bindings = <&kp X>;
            key-positions = <10 20 3 13>;
            timeout-ms = <100>;
        };

        combo_c {
            bindings = <&kp C>;
            key-positions = <20 21>;
            timeout-ms = <100>;
        };

        combo_v {
            bindings = <&kp V>;
            key-positions = <2 3>;
            timeout-ms = <100>;
        };

        combo_b {
            bindings = <&kp B>;
            key-positions = <2 13 3>;
            timeout-ms = <100>;
        };

        combo_n {
            bindings = <&kp N>;
            key-positions = <10 2 21>;
            timeout-ms = <100>;
        };

        combo_m {
            bindings = <&kp M>;
            key-positions = <10 20 21 15>;
            timeout-ms = <100>;
        };

        combo_comma {
            bindings = <&kp COMMA>;
            key-positions = <12 13 21>;
            timeout-ms = <100>;
        };

        combo_dot {
            bindings = <&kp PERIOD>;
            key-positions = <12 21>;
            timeout-ms = <100>;
        };

        combo_slash {
            bindings = <&kp SLASH>;
            key-positions = <2 12 21>;
            timeout-ms = <100>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEF {
            bindings = <
&kp ESC    &kt LEFT_SHIFT                   &kp T                            &kp UP               &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9
&kt LCTRL  &kp TAB         &kt LGUI  &kp A  &kp S         &kp E    &kp LEFT  &kp TAB   &kp RIGHT  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6
           &kt LEFT_ALT                     &kp SPACE                        &kp DOWN             &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3
&kp SPACE  &mo 1                            &kp LEFT_ALT  &kp E    &kp L     &kp N                &kp N0        &kp DOT       &kp ENTER
            >;
        };

        LWR {
            bindings = <
&trans  &trans                  &trans                          &bt BT_SEL 1                &kp F7   &kp F8   &kp F9
&trans  &trans  &trans  &trans  &trans  &trans    &bt BT_SEL 0  &bt BT_CLR    &bt BT_SEL 2  &kp F4   &kp F5   &kp F6
        &trans                  &trans                          &trans                      &kp F1   &kp F2   &kp F3
&trans  &trans                  &trans  &trans    &trans        &trans                      &kp F10  &kp F11  &kp F12
            >;
        };
    };
};
